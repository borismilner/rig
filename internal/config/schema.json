{
  "$id": "rig://schema/rig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "default": "Asia/Jerusalem",
          "x-rig-apply": "live",
          "description": "time zone used for quiet hours in question policies"
        },
        "policies": {
          "type": "array",
          "default": [],
          "maxItems": 128,
          "x-rig-apply": "live",
          "description": "kind-specific delivery rules for questions",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mode"],
            "properties": {
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
              "mode": {"type": "string", "enum": ["ordinary", "always", "never"]},
              "quiet_hours": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start", "end"],
                "properties": {
                  "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
                  "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
                }
              },
              "max_per_hour": {"type": "integer", "minimum": 1, "maximum": 1000},
              "routine_channels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["desktop", "phone", "telegram"]}},
              "normal_channels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["desktop", "phone", "telegram"]}},
              "urgent_channels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["desktop", "phone", "telegram"]}}
            }
          }
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "default": [],
          "maxItems": 256,
          "x-rig-apply": "restart",
          "description": "Named filesystem watches; read from the resolved settings at startup. Each group keeps mandatory ignores.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "paths"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "ignore": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "debounce_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31536000000
              },
              "description": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "max_watches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 8192,
          "x-rig-apply": "restart",
          "description": "Maximum directory subscriptions, including overlap during replacement."
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "default": 100000,
          "x-rig-apply": "restart",
          "description": "Maximum snapshot entries summed across watch groups."
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "x-rig-apply": "live",
          "description": "the daemon's log floor; read on every line"
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "default": 30,
              "x-rig-apply": "restart",
              "description": "a closed log segment moves to archive/ after this many days since its last record; it is still read (plan/49 decision 11)"
            }
          }
        },
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 67108864,
              "default": 2097152,
              "x-rig-apply": "restart",
              "description": "the log store's ring in memory, for every client together (plan/49 decision 5)"
            }
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cap": {
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 65536,
                  "default": 4096,
                  "x-rig-apply": "restart",
                  "description": "a call record holds a payload inline up to this many bytes, else in the blob area; its full size is always recorded (plan/49 decision 7)"
                }
              }
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 1099511627776,
              "default": 524288000,
              "x-rig-apply": "restart",
              "description": "the log store's size ceiling on disk, segments and blobs together; past it the oldest unpinned segment is unlinked, after the rate ceiling and before age"
            }
          }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000000,
              "default": 1000,
              "x-rig-apply": "restart",
              "description": "each client's rate ceiling in records a second, past its burst; records over it are sampled out and a band says how many (plan/49 decision 11)"
            },
            "burst": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10000000,
              "default": 5000,
              "x-rig-apply": "restart",
              "description": "how many records a client may send at once before its rate ceiling applies"
            }
          }
        },
        "delete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "default": 90,
              "x-rig-apply": "restart",
              "description": "a log segment is unlinked after this many days since its last record, unless pinned; the coverage log says so"
            }
          }
        },
        "flush": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10000,
              "default": 250,
              "x-rig-apply": "restart",
              "description": "how long after the first unwritten record the log store writes; a crash loses at most this much"
            },
            "bytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 4194304,
              "default": 262144,
              "x-rig-apply": "restart",
              "description": "the log store writes sooner once this much is waiting"
            }
          }
        }
      }
    },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scan": {
          "type": "string",
          "maxLength": 4096,
          "default": "~/.local/lib/rig/apps",
          "x-rig-apply": "restart",
          "description": "directories rig scans for programs, colon-separated; everything in one is a program and declares how it is loaded (plan/54, decision 0265)"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650,
                  "default": 7,
                  "x-rig-apply": "live",
                  "description": "notifications older than this leave the dashboard's panel; they stay in the record (plan/55 requirement 8)"
                }
              }
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "default": "",
          "x-rig-apply": "live",
          "description": "shown in place of this user's own seat on provenance surfaces; empty falls back to the seat name"
        }
      }
    }
  }
}
