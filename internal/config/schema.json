{
  "$id": "rig://schema/rig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "x-rig-apply": "live",
          "description": "the daemon's log floor; read on every line"
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 67108864,
              "default": 2097152,
              "x-rig-apply": "restart",
              "description": "the log store's ring in memory, for every client together (plan/49 decision 5)"
            }
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cap": {
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 65536,
                  "default": 4096,
                  "x-rig-apply": "restart",
                  "description": "a call record holds a payload inline up to this many bytes, else in the blob area; its full size is always recorded (plan/49 decision 7)"
                }
              }
            }
          }
        },
        "flush": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10000,
              "default": 250,
              "x-rig-apply": "restart",
              "description": "how long after the first unwritten record the log store writes; a crash loses at most this much"
            },
            "bytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 4194304,
              "default": 262144,
              "x-rig-apply": "restart",
              "description": "the log store writes sooner once this much is waiting"
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "default": "",
          "x-rig-apply": "live",
          "description": "shown in place of this user's own seat on provenance surfaces; empty falls back to the seat name"
        }
      }
    }
  }
}
